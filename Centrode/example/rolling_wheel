<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>구르는 바퀴의 속도와 centrode</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500&display=swap">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.42.0/dist/tabler-icons.min.css">
<style>
:root {
  color-scheme: light dark;
  --font-sans: "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
  --radius: 0.5rem;
  --surface-1: #fcfcfb;
  --text-primary: #0b0b0b;
  --text-secondary: #52514e;
  --border: hsl(0 0% 4% / 10%);
  --border-strong: hsl(0 0% 4% / 20%);
  --thumb: #ffffff;
  --track: rgba(0, 0, 0, 0.08);
}
@media (prefers-color-scheme: dark) {
  :root {
    --surface-1: #151515;
    --text-primary: #f0efec;
    --text-secondary: #c3c2b7;
    --border: hsl(0 0% 100% / 10%);
    --border-strong: hsl(0 0% 100% / 20%);
    --thumb: #1a1a19;
    --track: rgba(255, 255, 255, 0.1);
  }
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { padding: 16px; font-family: var(--font-sans); color: var(--text-primary); background: var(--surface-1); }
input, button, text { font-family: var(--font-sans); }
#vis-container { width: 100%; position: relative; }
#vis-container > svg { display: block; margin-inline: auto; max-width: 100%; height: auto; overflow: visible; }
.th { font-size: 14px; fill: var(--text-primary); font-weight: 500; }
.ts { font-size: 12px; fill: var(--text-secondary); }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; height: 4px; background: var(--track); border-radius: 2px; outline: none; }
input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%; background: var(--thumb); border: 1px solid var(--border-strong); cursor: pointer; }
input[type="range"]::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--thumb); border: 1px solid var(--border-strong); cursor: pointer; }
button { font-size: 14px; background: transparent; color: var(--text-primary); border: 0.5px solid var(--border-strong); border-radius: var(--radius); cursor: pointer; transition: background 0.15s, transform 0.1s; }
button:hover { background: var(--border); }
button:active { transform: scale(0.98); }
</style>
</head>
<body>
<div id="vis-container">
<h2 class="sr-only">미끄럼 없이 구르는 바퀴의 두 점 A, B의 속도 Va, Vb와 공간 centrode인 지면, 물체 centrode인 바퀴 테두리를 보여 주는 애니메이션</h2>
<svg width="100%" viewBox="0 0 680 462" role="img">
<title>구르는 바퀴의 속도와 centrode</title>
<desc>위쪽은 지면에서 본 모습으로 바퀴가 오른쪽으로 구르고 점 A, B의 속도 화살표가 표시됩니다. 아래쪽은 바퀴에서 본 모습으로 바퀴가 멈춰 있고 지면이 바퀴 둘레를 돕니다.</desc>
<defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></marker>
<clipPath id="wheelClip"><rect x="130" y="288" width="420" height="168" rx="12"></rect></clipPath></defs>
<text class="th" x="340" y="18" text-anchor="middle">지면에 서서 본 모습</text>
<text class="ts" x="340" y="36" text-anchor="middle">지면(공간 centrode)이 멈춰 있고 바퀴가 구름</text>
<g id="W"></g>
<line x1="20" y1="240" x2="660" y2="240" stroke="var(--border)" stroke-width="0.5"></line>
<text class="th" x="340" y="260" text-anchor="middle">바퀴에 올라타서 본 모습</text>
<text class="ts" x="340" y="278" text-anchor="middle">바퀴 테두리(물체 centrode)가 멈춰 있고 지면이 바퀴 둘레를 구름</text>
<rect x="130" y="288" width="420" height="168" rx="12" fill="none" stroke="var(--border)" stroke-width="0.5"></rect>
<g clip-path="url(#wheelClip)"><g id="G"></g></g>
<g id="H"></g>
</svg>
<div style="display:flex;flex-wrap:wrap;gap:16px;font-size:13px;color:var(--text-secondary);margin:8px 0 14px">
<span><span style="display:inline-block;width:18px;height:3px;background:#378ADD;vertical-align:middle;margin-right:6px"></span>Va</span>
<span><span style="display:inline-block;width:18px;height:3px;background:#D4537E;vertical-align:middle;margin-right:6px"></span>Vb</span>
<span><span style="display:inline-block;width:10px;height:10px;background:#D85A30;margin-right:6px"></span>공간 centrode (지면)</span>
<span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#1D9E75;margin-right:6px"></span>물체 centrode (테두리)</span>
<span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#BA7517;margin-right:6px"></span>순간중심 C</span>
</div>
<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
<button id="play" aria-label="일시정지" style="width:36px;height:36px;padding:0;display:flex;align-items:center;justify-content:center"><i id="playIcon" class="ti ti-player-pause" aria-hidden="true"></i></button>
<label for="s" style="font-size:14px;color:var(--text-secondary)">회전각</label>
<input type="range" id="s" min="0" max="360" step="0.5" value="0" style="flex:1">
<span id="ang" style="font-size:14px;font-weight:500;min-width:44px;text-align:right">0°</span>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px">
<div style="background:var(--surface-1);border-radius:var(--radius);padding:12px 16px"><div style="font-size:13px;color:var(--text-secondary)">|Va|</div><div id="va" style="font-size:22px;font-weight:500;color:#378ADD">2.00 V₀</div></div>
<div style="background:var(--surface-1);border-radius:var(--radius);padding:12px 16px"><div style="font-size:13px;color:var(--text-secondary)">|Vb|</div><div id="vb" style="font-size:22px;font-weight:500;color:#D4537E">1.41 V₀</div></div>
<div style="background:var(--surface-1);border-radius:var(--radius);padding:12px 16px"><div style="font-size:13px;color:var(--text-secondary)">지면 위 이동 거리</div><div id="d1" style="font-size:22px;font-weight:500">0.00 R</div></div>
<div style="background:var(--surface-1);border-radius:var(--radius);padding:12px 16px"><div style="font-size:13px;color:var(--text-secondary)">테두리 위 이동 거리</div><div id="d2" style="font-size:22px;font-weight:500">0.00 R</div></div>
</div>
<script>
const R=55,GY=200,X0=150,CA='#378ADD',CB='#D4537E',SP='#D85A30',BD='#1D9E75',IC='#BA7517',PI=Math.PI;
const f=n=>n.toFixed(1),P='var(--text-primary)',Q='var(--text-secondary)';
const ln=(x1,y1,x2,y2,c,w,e='')=>`<line x1="${f(x1)}" y1="${f(y1)}" x2="${f(x2)}" y2="${f(y2)}" stroke="${c}" stroke-width="${w}" stroke-linecap="round" ${e}/>`;
const dot=(x,y,c,r=3.5)=>`<circle cx="${f(x)}" cy="${f(y)}" r="${r}" fill="${c}"/>`;
const sq=(x,y,c)=>`<rect x="${f(x-3.5)}" y="${f(y-3.5)}" width="7" height="7" fill="${c}"/>`;
const tx=(x,y,s,c)=>`<text class="th" x="${f(x)}" y="${f(y)}" text-anchor="middle" dominant-baseline="central"${c?` style="fill:${c}"`:''}>${s}</text>`;
function arc(cx,cy,r,a0,a1,c,w){if(Math.abs(a1-a0)<.001)return'';let d='';for(let i=0;i<=72;i++){const a=a0+(a1-a0)*i/72;d+=(i?'L':'M')+f(cx+r*Math.cos(a))+' '+f(cy-r*Math.sin(a))}return `<path d="${d}" fill="none" stroke="${c}" stroke-width="${w}" stroke-linecap="round"/>`}
const ticks=[0,1,2,3,4,5,6,7,8].map(k=>k*PI/4);
function arrow(x,y,vx,vy,c,name){const n=Math.hypot(vx,vy);if(n<4)return'';const ex=x+vx,ey=y-vy;return ln(x,y,ex,ey,c,2.5,'marker-end="url(#arrow)"')+tx(ex+vx/n*14,ey-vy/n*14,name,c)}
function draw(deg){
const phi=deg*PI/180,s=phi*R,cx=X0+s,cy=GY-R;
let w=ln(30,GY,650,GY,SP,1.5,'stroke-dasharray="3 4" opacity="0.6"');
if(s>0)w+=ln(X0,GY,cx,GY,SP,3.5);
ticks.forEach(t=>{w+=sq(X0+t*R,GY,SP)});
w+=`<circle cx="${f(cx)}" cy="${f(cy)}" r="${R}" fill="var(--surface-1)" stroke="${BD}" stroke-width="1.5" stroke-dasharray="3 4"/>`;
w+=arc(cx,cy,R,-PI/2-phi,-PI/2,BD,3.5);
[0,1,2,3].forEach(k=>{const a=k*PI/2+PI/4-phi;w+=ln(cx,cy,cx+R*.85*Math.cos(a),cy-R*.85*Math.sin(a),'var(--border-strong)',1)});
ticks.slice(0,8).forEach(t=>{const a=-PI/2+t-phi;w+=dot(cx+R*Math.cos(a),cy-R*Math.sin(a),BD)});
const aA=PI/2-phi,aB=-phi,ax=cx+R*Math.cos(aA),ay=cy-R*Math.sin(aA),bx=cx+R*Math.cos(aB),by=cy-R*Math.sin(aB);
w+=ln(ax,ay,cx,GY,CA,1,'stroke-dasharray="4 4"')+ln(bx,by,cx,GY,CB,1,'stroke-dasharray="4 4"');
const k=.9,rax=ax-cx,ray=GY-ay,rbx=bx-cx,rby=GY-by;
w+=arrow(ax,ay,k*ray,-k*rax,CA,'Va')+arrow(bx,by,k*rby,-k*rbx,CB,'Vb');
w+=dot(cx,cy,Q,3)+dot(ax,ay,CA,5.5)+dot(bx,by,CB,5.5)+dot(cx,GY,IC,6.5);
w+=tx(ax-13*Math.cos(aA)*-1,ay-13*Math.sin(aA),'A',CA)+tx(bx+13*Math.cos(aB),by-13*Math.sin(aB),'B',CB)+tx(cx,GY+17,'C');
document.getElementById('W').innerHTML=w;
const hx=340,hy=372,rot=(x,y)=>[hx+x*Math.cos(phi)-y*Math.sin(phi),hy-(x*Math.sin(phi)+y*Math.cos(phi))];
const a1=rot(-500,-R),a2=rot(500,-R),t1=rot(-s,-R),t2=rot(0,-R);
let g=ln(a1[0],a1[1],a2[0],a2[1],SP,1.5,'stroke-dasharray="3 4" opacity="0.6"');
if(s>0)g+=ln(t1[0],t1[1],t2[0],t2[1],SP,3.5);
ticks.forEach(t=>{const p=rot(t*R-s,-R);g+=sq(p[0],p[1],SP)});
document.getElementById('G').innerHTML=g;
const bodyC=-PI/2+phi,ix=hx+R*Math.cos(bodyC),iy=hy-R*Math.sin(bodyC);
let h=`<circle cx="${hx}" cy="${hy}" r="${R}" fill="var(--surface-1)" stroke="${BD}" stroke-width="1.5" stroke-dasharray="3 4"/>`;
h+=arc(hx,hy,R,-PI/2,bodyC,BD,3.5);
[0,1,2,3].forEach(k=>{const a=k*PI/2+PI/4;h+=ln(hx,hy,hx+R*.85*Math.cos(a),hy-R*.85*Math.sin(a),'var(--border-strong)',1)});
ticks.slice(0,8).forEach(t=>{const a=-PI/2+t;h+=dot(hx+R*Math.cos(a),hy-R*Math.sin(a),BD)});
h+=dot(hx,hy,Q,3)+dot(hx,hy-R,CA,5.5)+dot(hx+R,hy,CB,5.5)+tx(hx,hy-R+13,'A',CA)+tx(hx+R-13,hy,'B',CB);
h+=dot(ix,iy,IC,6.5)+tx(hx+(R-14)*Math.cos(bodyC),hy-(R-14)*Math.sin(bodyC),'C');
document.getElementById('H').innerHTML=h;
const da=Math.hypot(rax,ray)/R,db=Math.hypot(rbx,rby)/R;
document.getElementById('va').textContent=da.toFixed(2)+' V₀';
document.getElementById('vb').textContent=db.toFixed(2)+' V₀';
document.getElementById('d1').textContent=phi.toFixed(2)+' R';
document.getElementById('d2').textContent=phi.toFixed(2)+' R';
document.getElementById('ang').textContent=Math.round(deg)+'°';
}
const S=document.getElementById('s'),BT=document.getElementById('play'),IK=document.getElementById('playIcon');
let on=!matchMedia('(prefers-reduced-motion: reduce)').matches,last=0,hold=0;
function ui(){IK.className='ti '+(on?'ti-player-pause':'ti-player-play');BT.setAttribute('aria-label',on?'일시정지':'재생')}
function tick(n){const dt=Math.min(n-last,50);last=n;if(on){if(hold>0){hold-=dt;if(hold<=0)S.value=0}else{let v=+S.value+dt*.036;if(v>=360){v=360;hold=1200}S.value=v}draw(+S.value)}requestAnimationFrame(tick)}
BT.onclick=()=>{on=!on;hold=0;if(on&&+S.value>=360)S.value=0;ui()};
S.oninput=()=>{on=false;hold=0;ui();draw(+S.value)};
ui();draw(0);requestAnimationFrame(t=>{last=t;tick(t)});
</script>
</div>
</body>
</html>
